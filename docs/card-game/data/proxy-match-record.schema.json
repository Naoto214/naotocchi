{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naotocchi.example/schema/card-game/proxy-match-record.v1.json",
  "title": "なおとっちカードゲーム・プロキシ対戦記録",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "match_id", "design", "test_plan", "input", "record"],
  "properties": {
    "schema_version": {"const": "naotocchi.card_game.proxy_match_record.v1"},
    "match_id": {"type": "string", "minLength": 1},
    "design": {"$ref": "#/$defs/design"},
    "test_plan": {"$ref": "#/$defs/testPlan"},
    "input": {"$ref": "#/$defs/input"},
    "record": {"$ref": "#/$defs/record"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "playerId": {"enum": ["A", "B"]},
    "cardCopyId": {"type": "string", "pattern": "^[AB]-[0-9]{3}$"},
    "instanceId": {"type": "string", "pattern": "^[AB]-[0-9]{3}#[1-9][0-9]*$"},
    "cardInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_copy_id", "initial_instance_id", "card_id"],
      "properties": {
        "card_copy_id": {"$ref": "#/$defs/cardCopyId"},
        "initial_instance_id": {"$ref": "#/$defs/instanceId"},
        "card_id": {"type": "string", "minLength": 1}
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "rules_commit", "rules_tree", "catalog_records_sha256", "pool_snapshot"],
      "properties": {
        "repository": {"const": "Naoto214/naotocchi"},
        "rules_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "rules_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "catalog_records_sha256": {"$ref": "#/$defs/sha256"},
        "pool_snapshot": {"type": "string", "minLength": 1}
      }
    },
    "testPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "strata", "automated_game"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "strata": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "automated_game": {"const": false}
      }
    },
    "playerInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["player_id", "seat", "deck_order_top_to_bottom", "initial_hand"],
      "properties": {
        "player_id": {"$ref": "#/$defs/playerId"},
        "seat": {"enum": ["first", "second"]},
        "deck_order_top_to_bottom": {
          "type": "array",
          "minItems": 40,
          "maxItems": 40,
          "items": {"$ref": "#/$defs/cardInstance"}
        },
        "initial_hand": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/instanceId"}
        }
      }
    },
    "declaredChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choice_id", "owner", "kind", "value"],
      "properties": {
        "choice_id": {"type": "string", "minLength": 1},
        "owner": {"$ref": "#/$defs/playerId"},
        "kind": {"type": "string", "minLength": 1},
        "value": {},
        "note": {"type": "string"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_player", "initial_growth", "initial_hand_size", "players", "declared_choices"],
      "properties": {
        "first_player": {"$ref": "#/$defs/playerId"},
        "initial_growth": {"type": "integer", "minimum": 0},
        "initial_hand_size": {"const": 5},
        "players": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/playerInput"}},
        "declared_choices": {"type": "array", "items": {"$ref": "#/$defs/declaredChoice"}}
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "hand_to_discard", "prepared_to_discard", "deck_to_bottom"],
      "properties": {
        "time": {"type": "integer", "minimum": 0},
        "hand_to_discard": {"type": "array", "items": {"$ref": "#/$defs/instanceId"}},
        "prepared_to_discard": {"type": "array", "items": {"$ref": "#/$defs/instanceId"}},
        "deck_to_bottom": {"type": "array", "items": {"$ref": "#/$defs/instanceId"}}
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain_id", "link_index", "responds_to_seq"],
      "properties": {
        "chain_id": {"type": "string", "minLength": 1},
        "link_index": {"type": "integer", "minimum": 1},
        "responds_to_seq": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "round", "player"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "round": {"type": ["integer", "null"], "minimum": 1},
        "player": {"oneOf": [{"$ref": "#/$defs/playerId"}, {"type": "null"}]}
      }
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reservation_id", "source_instance_id", "controller", "target_instance_ids", "created_seq", "deadline", "uses_remaining", "status"],
      "properties": {
        "reservation_id": {"type": "string", "minLength": 1},
        "source_instance_id": {"$ref": "#/$defs/instanceId"},
        "controller": {"$ref": "#/$defs/playerId"},
        "target_instance_ids": {"type": "array", "items": {"$ref": "#/$defs/instanceId"}},
        "created_seq": {"type": "integer", "minimum": 1},
        "deadline": {"$ref": "#/$defs/deadline"},
        "uses_remaining": {"type": ["integer", "null"], "minimum": 0},
        "status": {"enum": ["active", "consumed", "expired", "cancelled"]}
      }
    },
    "instanceTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_copy_id", "from_instance_id", "to_instance_id", "reason"],
      "properties": {
        "card_copy_id": {"$ref": "#/$defs/cardCopyId"},
        "from_instance_id": {"$ref": "#/$defs/instanceId"},
        "to_instance_id": {"$ref": "#/$defs/instanceId"},
        "reason": {"const": "zone_change"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "round", "turn_player", "phase", "actor", "action_type", "source_instance_id", "target_instance_ids", "payment", "choice_ids", "chain", "reservations_created", "reservations_consumed", "instance_transitions", "before_state_sha256", "after_state_sha256", "result"],
      "properties": {
        "seq": {"type": "integer", "minimum": 1},
        "round": {"type": "integer", "minimum": 1},
        "turn_player": {"$ref": "#/$defs/playerId"},
        "phase": {"type": "string", "minLength": 1},
        "actor": {"$ref": "#/$defs/playerId"},
        "action_type": {"type": "string", "minLength": 1},
        "source_instance_id": {"oneOf": [{"$ref": "#/$defs/instanceId"}, {"type": "null"}]},
        "target_instance_ids": {"type": "array", "items": {"$ref": "#/$defs/instanceId"}},
        "payment": {"$ref": "#/$defs/payment"},
        "choice_ids": {"type": "array", "items": {"type": "string"}},
        "chain": {"$ref": "#/$defs/chain"},
        "reservations_created": {"type": "array", "items": {"type": "string"}},
        "reservations_consumed": {"type": "array", "items": {"type": "string"}},
        "instance_transitions": {"type": "array", "items": {"$ref": "#/$defs/instanceTransition"}},
        "before_state_sha256": {"$ref": "#/$defs/sha256"},
        "after_state_sha256": {"$ref": "#/$defs/sha256"},
        "result": {"type": "string"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["winner", "reason", "rounds_completed", "final_growth", "notes"],
      "properties": {
        "winner": {"enum": [null, "A", "B", "draw"]},
        "reason": {"type": ["string", "null"]},
        "rounds_completed": {"type": "integer", "minimum": 0},
        "final_growth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["A", "B"],
          "properties": {"A": {"type": "integer", "minimum": 0}, "B": {"type": "integer", "minimum": 0}}
        },
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "events", "reservations", "result"],
      "properties": {
        "status": {"enum": ["fixture", "in_progress", "completed", "aborted"]},
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "reservations": {"type": "array", "items": {"$ref": "#/$defs/reservation"}},
        "result": {"$ref": "#/$defs/result"}
      }
    }
  }
}
